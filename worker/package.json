{
  "name": "mustplay-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "login": "wrangler login",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "secrets": "wrangler secret put TWITCH_CLIENT_ID && wrangler secret put TWITCH_CLIENT_SECRET",
    "secret:qloo": "wrangler secret put QLOO_API_KEY",
    "secret:appkey": "wrangler secret put APP_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5.6",
    "wrangler": "^4.0.0"
  }
}
